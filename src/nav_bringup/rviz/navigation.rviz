Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Tree Height: 560
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 30
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Draw Behind: true
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.3
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RegisteredScan
      Topic:
        Value: /cloud_registered
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 1
      Color Transformer: AxisColor
      Axis: Z
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Topic:
        Value: /plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Width: 0.03
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/Path
      Name: LocalPlan
      Topic:
        Value: /local_plan
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 0; 128; 255
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 1
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Names: true
      Marker Scale: 0.5
      Frame Timeout: 15
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Topic:
        Value: /odom
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 50
      Position Tolerance: 0.2
      Angle Tolerance: 0.2
      Shape:
        Value: Arrow
        Shaft Length: 0.3
      Enabled: false
      Value: false
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Pitch: 1.2
      Yaw: 0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 950
  Width: 1500
