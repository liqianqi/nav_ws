# =============================================================================
#  ROS 2 导航工作空间 .gitignore
#
#  策略: 源码全部入库(包括修改过的第三方库 small_gicp / FAST_LIO_ROS2 /
#        pcd2pgm / livox_ros_driver2), 只排除构建产物与大文件。
#
#  已处理: third_party/small_gicp、src/FAST_LIO_ROS2、src/pcd2pgm 原为独立
#          git 仓库, 其内层 .git 已删除, 现作为本仓库的普通文件夹提交。
#          如需还原历史, 可从对应 GitHub 仓库重新 clone。
#          src/livox_ros_driver2 本来就没有 .git, 直接入库。
# =============================================================================

# ----------------------------------------------------------------------------
#  Colcon / catkin 构建产物
# ----------------------------------------------------------------------------
build/
install/
log/

# 各包内单独构建的产物(如 small_gicp/build)
**/build/

# ----------------------------------------------------------------------------
#  clangd / 编译数据库
# ----------------------------------------------------------------------------
.cache/
compile_commands.json

# ----------------------------------------------------------------------------
#  大数据 / 点云 / 地图 (体积过大, 不入库)
# ----------------------------------------------------------------------------
*.pcd
*.pcd.*
*.ply
maps/*.pcd
data/*.pcd

# 录制数据
*.bag
*.bag.*
*.db3
*.mcap

# ----------------------------------------------------------------------------
#  大型二进制 / 演示文件 (单独点名, 避免误删小文件)
#  (下列文件均 >5MB; 同名 ASCII 风格的小文件不在此列)
# ----------------------------------------------------------------------------
# 根目录临时扫描点云
/scans.pcd

# 大尺寸 STL 网格
src/nav_bringup/meshes/ow150_sk_tt_l_00_6寸全向轮_ad.stl
src/nav_bringup/meshes/cahssis_s_u.stl

# FAST_LIO 大体积文档/动画
src/FAST_LIO_ROS2/doc/real_experiment2.gif
src/FAST_LIO_ROS2/doc/ulhkwh_fastlio.gif
src/FAST_LIO_ROS2/doc/Fast_LIO_2.pdf

# ----------------------------------------------------------------------------
#  C/C++ 编译中间产物
# ----------------------------------------------------------------------------
*.o
*.a
*.so
*.so.*
*.dylib
*.lo
*.la

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ----------------------------------------------------------------------------
#  IDE / 编辑器
# ----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# CMake(包内单独构建时生成)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
!**/CMakeLists.txt
